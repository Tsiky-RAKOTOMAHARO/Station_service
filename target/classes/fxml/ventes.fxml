<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

fx:controller="com.station.controller.VenteController"
xmlns:fx="http://javafx.com/fxml"
xmlns="http://javafx.com/javafx">

    <VBox spacing="15">
        <HBox spacing="10">
            <ComboBox fx:id="cbClient" promptText="Sélectionner un client"/>
            <ComboBox fx:id="cbProduit" promptText="Sélectionner un produit"/>
            <TextField fx:id="txtNbrLitre" promptText="Nombre de litres"/>
            <Button text="Enregistrer l'achat" fx:id="btnEnregistrer" onAction="#handleEnregistrerAchat"/>
        </HBox>
        <TableView fx:id="tableVentes" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colNumAchat" text="N° Achat"/>
                <TableColumn fx:id="colClient" text="Client"/>
                <TableColumn fx:id="colProduit" text="Produit"/>
                <TableColumn fx:id="colNbrLitre" text="Litres"/>
                <TableColumn fx:id="colMontant" text="Montant Total"/>
                <TableColumn fx:id="colDate" text="Date"/>
            </columns>
        </TableView>
    </VBox>

</VBox>