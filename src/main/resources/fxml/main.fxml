<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.station.controller.MainController"
            prefWidth="1024" prefHeight="768">
    <left>
        <VBox spacing="10" style="-fx-padding: 15; -fx-background-color: #2c3e50;" prefWidth="200">
            <Button fx:id="btnDashboard" text="Dashboard" maxWidth="Infinity" onAction="#handleNavDashboard"/>
            <Button fx:id="btnVentes" text="Ventes" maxWidth="Infinity" onAction="#handleNavVentes"/>
            <Button fx:id="btnStocks" text="Stocks" maxWidth="Infinity" onAction="#handleNavStocks"/>
            <Button fx:id="btnEntretiens" text="Entretiens" maxWidth="Infinity" onAction="#handleNavEntretiens"/>
            <Button fx:id="btnClients" text="Clients" maxWidth="Infinity" onAction="#handleNavClients"/>
        </VBox>
    </left>
    <center>
        <StackPane fx:id="contentArea"/>
    </center>
</BorderPane>